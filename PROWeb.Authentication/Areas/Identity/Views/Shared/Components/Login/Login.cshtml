@using PROWeb.Authentication.ViewModels.Account;
@model LoginViewModel;

<div>
    <div>
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </div>
    <div>
         <kendo-form 
            asp-antiforgery="true" 
            buttons-template-id="login-button-template" 
            class="login-form" 
            name="Login" 
            form-data="@Model" 
           
            method="POST">
            <form-items>
                <form-item class="form-control" field="Email">
                    <item-label text="Email:" />
                </form-item>
                <form-item field="Password" hint="Hint: enter alphanumeric characters only.">
                    <item-label text="Password:">
                </form-item>
                <form-item field="RememberMe">
                    <item-label text="Remember Me" />
                </form-item>
            </form-items>
            <validatable validate-on-blur="true" />
        </kendo-form>
    </div>
</div>


<style>
    .login-form {
        width: 350px;
    }
</style>


<script id="login-button-template" type="text/html">
    <div class="d-flex justify-content-end  w-100">
        <div>
            <button class='k-button k-button-md k-rounded-md k-button-solid k-button-solid-primary k-form-submit'>Sign In</button>
            <button class='k-button k-button-md k-rounded-md k-button-solid k-button-solid-base k-form-clear'>Clear</button>
        </div>
    </div>
</script>