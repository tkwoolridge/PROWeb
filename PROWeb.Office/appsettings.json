{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level}] {UserId} {Message}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PROWebConnection": "Server=.\\SQLExpress;Database=PROWEB_DEV;Trusted_Connection=True;;Trust Server Certificate=True;MultipleActiveResultSets=true;",
    "PROWebIdentityConnection": "Server=.\\SQLExpress;Database=PROWEB_OFFICE_IDENTITY_DEV;Trusted_Connection=True;;Trust Server Certificate=True;MultipleActiveResultSets=true;"
  }
}
