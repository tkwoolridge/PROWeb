@using PROWeb.Components.Common.Views;
@using PROWeb.Components.Layouts;
@using PROWeb.Components.Person;
@using PROWeb.Components.Voters.ViewModels;
@using PROWeb.Components.Voters;
@using Telerik.FontIcons;
@using PROWeb.Components.Common.Layouts;
@inherits VoterViewBase<VoterViewModel>;

<style>
    .voter-main-view {
        display: grid;
        grid-template-rows: auto auto 1fr;
        grid-template-columns: auto 1fr;
        gap: 5px 15px;
    }

    .address-view
    {
        grid-area: 3/1 / 3/3;
        align-content: start;
    }

    .voter-tab-view
    {
        height: 440px;
    }

    .person-details-view {
        align-content: start;
    }
</style>

<ViewsLayout TViewModel="VoterViewModel" Class="p-container" Editable="@Editable" @ref="@LayoutRef">
    <Views>
        <TelerikTabStrip 
            Class="voter-tab-view" PersistTabContent="true" @bind-ActiveTabIndex="@TabIndex">
            <TabStripTab Title="Voter">
                <div class="voter-main-view">
                    <VoterPhotosView />
                    <VoterDetailsView Title="Voter Details:"/>
                    <div class="address-view">
                        <VoterAddressView Title="Address:" />
                    </div>
                </div>
            </TabStripTab>
            <TabStripTab Title="Contact">
                <VoterContactInfoView/>
            </TabStripTab>
            <TabStripTab Title="Flags">
                <VoterFlagsView />
            </TabStripTab>
            <TabStripTab Title="Documents">
                <VoterDocumentsView />
            </TabStripTab>
        </TelerikTabStrip>                                                                                                  
    </Views>
    <Footer>
        <div class="d-flex justify-content-end mt-1 mb-2 mx-2">
            @if (Editable == true)
            {
                <TelerikButton OnClick="@OnUndo" Enabled="@CanUndo" Icon="FontIcon.Undo" Class="me-1">Undo</TelerikButton>
                <ListViewCommandButton Icon="@FontIcon.Save" Enabled="@CanSave" Command="Save" OnClick="@OnEditAsync" Class="me-1">Save</ListViewCommandButton>
                <ListViewCommandButton Icon="@FontIcon.Cancel" Command="Cancel">Cancel</ListViewCommandButton>
            }
            else
            {
                <ListViewCommandButton Icon="@FontIcon.Pencil" Command="Edit">Edit</ListViewCommandButton>
            }
        </div>
    </Footer>
</ViewsLayout>
