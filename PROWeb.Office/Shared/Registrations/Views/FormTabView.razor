@using PROWeb.Components.Common.Layouts;
@using PROWeb.Components.Common.Views;
@using PROWeb.Data.Models.Enums;
@using PROWeb.Components.Person;
@using PROWeb.Office.Registrations.Views
@using PROWeb.Office.Shared.Registrations.ViewModels;
@using Telerik.FontIcons;
@inherits PROCompositView<ListRegistrationViewModel>;

<style>
    .voter-main-view {
        display: grid;
        grid-template-rows: auto auto 1fr;
        grid-template-columns: auto 1fr;
        gap: 5px 15px;
    }

    .address-view
    {
        grid-area: 3/1 / 3/3;
        align-content: start;
    }

    .voter-tab-view
    {
        height: 460px;
    }

    .person-details-view {
        align-content: start;
    }

    .k-tabstrip-content, .k-tabstrip > .k-content {
        background-color: transparent;
    }
</style>

<ViewsLayout Class="@(Model?.FormTypeId == (int)FormTypes.Form1? "form1-container" : "form2-container")" TViewModel="ListRegistrationViewModel" Editable="@Editable" @ref="@LayoutRef">
    <Views>
        <TelerikTabStrip Class="voter-tab-view" PersistTabContent="true" @bind-ActiveTabIndex="@TabIndex">
            <TabStripTab Title="Voter">
                <div class="voter-main-view">
                    <FormPhotosView />
                    <FormDetailsView Title="Voter Details:" />
                    <FormAddressView Title="Address:" />
                </div>
            </TabStripTab>
            <TabStripTab Title="Contact">
                <FormContactInfoView />
            </TabStripTab>
            <TabStripTab Title="Flags">
                <FormFlagsView />
            </TabStripTab>
        </TelerikTabStrip>
    </Views>
    <Footer>
        <div class="d-flex justify-content-end mt-1 mb-2 mx-2">
            @if (Editable == true)
            {

                <TelerikButton Icon="@FontIcon.Check" Class="me-1" OnClick="@OnApprove">Approve</TelerikButton>
                <TelerikButton Icon="@FontIcon.Cancel" Class="me-1" OnClick="@OnReject">Reject</TelerikButton>
                <ListViewCommandButton Icon="@FontIcon.Save" Enabled="@CanSave" Command="Save" OnClick="@OnSaveAsync" Class="me-1">Save</ListViewCommandButton>
                <ListViewCommandButton Icon="@FontIcon.Cancel" Command="Cancel">Cancel</ListViewCommandButton>
            }
            else
            {
                <TelerikButton Icon="@FontIcon.Check" Class="me-1" OnClick="@OnApprove">Approve</TelerikButton>
                <TelerikButton Icon="@FontIcon.Cancel" Class="me-1" OnClick="@OnReject">Reject</TelerikButton>
                <ListViewCommandButton Icon="@FontIcon.Pencil" Command="Edit">Edit</ListViewCommandButton>

            }
        </div>
    </Footer>
</ViewsLayout>
