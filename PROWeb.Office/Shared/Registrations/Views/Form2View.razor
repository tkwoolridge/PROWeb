@using PROWeb.Components.Person;
@using PROWeb.Office.Registrations.Views;
@inherits PROComponent;

<style>
    .form-background {
        background-color: #CDE6F6;
        border-radius: 5px;
    }
</style>

<FormView FormDescription="CHANGE REGITRATION DETAILS"
          FormName="FORM 2">
    <Form>
        <ExpansionPanel Class="my-1">
            <Header>
                <strong>VOTER PHOTOS</strong>
            </Header>
            <Content>
                <div class="d-flex justify-content-center">
                    <FormPhotosView />
                </div>
            </Content>
        </ExpansionPanel>
        <ExpansionPanel Class="my-1">
            <Header>
                <strong>VOTER DETAILS</strong>
            </Header>
            <Content>
                <FormDetailsView Editable="false" 
                    ShowPopulateDialogButton="true" 
                    PopulateDialog="PopulateDetailsDialogs.Voters"
                    ContactInfoView="@ContactInfoViewRef"
                    AddressView="@OldAddressViewRef"
                    FlagsView="@FormFlagsViewRef" />
            </Content>
        </ExpansionPanel>
        <ExpansionPanel Class="my-1" IsExpanded="false">
            <Header>
                <strong>OLD ADDRESS</strong>
            </Header>
            <Content>
                <FormOldAddressView Editable="false" @ref="@OldAddressViewRef" />
            </Content>
        </ExpansionPanel>
        <ExpansionPanel Class="my-1">
            <Header>
                <strong>ADDRESS</strong>
            </Header>
            <Content>
                <FormAddressView ShowPopulateDialogButton="true" />
            </Content>
        </ExpansionPanel>
        <ExpansionPanel Class="my-1" IsExpanded="false">
            <Header>
                <strong>CONTACT INFO</strong>
            </Header>
            <Content>
                <FormContactInfoView Editable="true" @ref="@ContactInfoViewRef" />
            </Content>
        </ExpansionPanel>
        <ExpansionPanel Class="my-1" IsExpanded="false">
            <Header>
                <strong>FLAGS</strong>
            </Header>
            <Content>
                <FormFlagsView @ref="FormFlagsViewRef" Editable="true" />
            </Content>
        </ExpansionPanel>
    </Form>
</FormView>

@code
{
    protected FormOldAddressView? OldAddressViewRef { get; set; }

    protected FormContactInfoView? ContactInfoViewRef { get; set; }

    protected FormFlagsView? FormFlagsViewRef { get; set; }
}
