@using PROWeb.Components.Common.Layouts;
@using PROWeb.Components.Common.Views;
@using PROWeb.Office.Shared.Registrations.ViewModels;
@using Telerik.FontIcons;
@inherits FormViewBase;

<style>
    .ep-container {
        border: 1px solid black;
        border-radius: 2px;
    }

    .ep-header {
        background-color: rgba(255, 255, 255, 0.5);
        color: black;
    }

    .form1-background {
        background-color: #B3E49F;
        border-radius: 5px;
    }

    .form2-background {
        background-color: #CDE6F6;
        border-radius: 5px;
    }
</style>

<div class="d-flex justify-content-center h-100">
    <div style="width:600px;" class="@Class p-2 h-100">
        <div class="h-100">
            <ViewsLayout TViewModel="RegistrationViewModel" Editable="true" @ref="LayoutRef">
                <Header>
                    <div class="d-flex justify-content-between py-2">
                        <div>
                            <span>Date: @(DateTime.Now.ToString("dd MMM yy hh:mm"))</span>
                            <br />
                            <span>Last Updated By: </span>
                            @if(Model?.LastUpdatedBy is { } userName)
                            {
                                <span class="k-text-info">@userName</span>
                            }
                            else
                            {
                                <span class="k-text-error">Not Assigned</span>
                            }
                        </div>
                        <div class="d-flex justify-content-end align-items-center">
                            <TelerikButton OnClick="@OnApproveAsync" Enabled="@CanApprove" Class="me-1" Icon="FontIcon.Check" />
                            <TelerikButton OnClick="@OnRejectAsync" Enabled="@CanReject" Class="me-1" Icon="FontIcon.Cancel" />
                            <TelerikButton OnClick="@OnSaveAsync" Enabled="@CanSave" Class="me-1" Icon="FontIcon.Save" />
                            <TelerikButton OnClick="@OnUndo" Enabled="@CanUndo" Icon="FontIcon.Undo" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-center py-2">
                        <span class="k-text-primary">@FormDescription</span>
                    </div>
                    <div class="d-flex justify-content-center py-2 form-header my-1">
                        <span>@FormName</span>
                    </div>
                </Header>
                <Views>
                    @Form
                </Views>
                <Footer>
                    @FormFooter
                </Footer>
            </ViewsLayout>
        </div>
    </div>
</div>