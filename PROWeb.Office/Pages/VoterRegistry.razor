@page "/"
@using PROWeb.Components.Navigation;
@using PROWeb.Components.Common;
@using PROWeb.Components.Person.Filters;
@using PROWeb.Office.Components.Voters;
@using PROWeb.Office.Components.Voters.Filters;
@using PROWeb.Office.ViewModels.Voters;
@using Telerik.Blazor.Components.PanelBar;
@using PROWeb.Office.Components.VoterRegistry;
@using Telerik.FontIcons;
@inherits PRORegistryLayout<FilterModel, ListVoterViewModel>

<FilterListLayout>
    <Filter>
        <ExpansionPanel>
            <Header>
                <strong>Filter:</strong>
            </Header>
            <ToolBar>
                <TelerikButtonGroup SelectionMode="@ButtonGroupSelectionMode.Single">
                    <ButtonGroupToggleButton @bind-Selected="@SimpleFilterSelected">Simple Search</ButtonGroupToggleButton>
                    <ButtonGroupToggleButton>Advanced Search</ButtonGroupToggleButton>
                </TelerikButtonGroup>
            </ToolBar>
            <Content>
                @FilterTemplate
            </Content>
        </ExpansionPanel>
    </Filter>
    <Toolbox>
        <TelerikButtonGroup SelectionMode="@ButtonGroupSelectionMode.Single">
            <ButtonGroupToggleButton @bind-Selected="@GridSelected" Icon="@FontIcon.Rows"/>
            <ButtonGroupToggleButton Icon="@FontIcon.Group" />
        </TelerikButtonGroup>
    </Toolbox>
    <List>
        @ListTemplate    
    </List>
</FilterListLayout>

@code
{
    private RenderFragment AdvancedFilterTemplate => @<VoterFilterAdvanced @ref="@FilterRef"></VoterFilterAdvanced>;

    private RenderFragment SimpleFilterTemplate => @<VoterFilterSimple @ref="@FilterRef"></VoterFilterSimple>;

    private RenderFragment List => @<VotersList @ref="ListRef" />;

    private RenderFragment Grid => @<VotersGrid @ref="ListRef" />;
}