@page "/"
@using PROWeb.Components.Common.Layouts
@using PROWeb.Components.Person.Filters;
@using PROWeb.Components.Voters.ViewModels;
@using Telerik.FontIcons;
@using PROWeb.Office.Shared.Registry;
@using PROWeb.Office.Shared.Registry.Filters;
@using PROWeb.Components.Voters.Filters;
@attribute [Authorize]
@inherits PRORegistryLayout<FilterModel, VoterViewModel>

<FilterListLayout>
    <Filter>
        <ExpansionPanel>
            <Header>
                <strong>Filter:</strong>
            </Header>
            <ToolBar>
                <TelerikButtonGroup SelectionMode="@ButtonGroupSelectionMode.Single">
                    <ButtonGroupToggleButton @bind-Selected="@SimpleFilterSelected">Simple Search</ButtonGroupToggleButton>
                    <ButtonGroupToggleButton>Advanced Search</ButtonGroupToggleButton>
                </TelerikButtonGroup>
            </ToolBar>
            <Content>
                @FilterTemplate
            </Content>
        </ExpansionPanel>
    </Filter>
    <Toolbox>
        <TelerikButtonGroup SelectionMode="@ButtonGroupSelectionMode.Single">
            <ButtonGroupToggleButton @bind-Selected="@GridSelected" Icon="@FontIcon.Rows"/>
            <ButtonGroupToggleButton Icon="@FontIcon.Group" />
        </TelerikButtonGroup>
    </Toolbox>
    <List>
        <div class="p-container h-100">
            @ListTemplate    
        </div>
    </List>
    <Footer>
        <div class="d-flex justify-content-end  align-items-center w-100 p-container p-2">
            <img class="me-2" style="width: 40px" src="/images/gender.png" />
            <span class="me-2"><b>F:</b> @FemaleCount <b>M:</b> @MaleCount  <b>N:</b> @NoneCount</span>
            <img class="me-2" style="width: 40px" src="/images/ballot.png" />
            <span class="me-2"><b>TOTAL:</b> @Total</span>
        </div>
    </Footer>
</FilterListLayout>

@code
{
    private RenderFragment AdvancedFilterTemplate => @<VoterFilterAdvanced @ref="@FilterRef"></VoterFilterAdvanced>;

    private RenderFragment SimpleFilterTemplate => @<VoterFilterSimple @ref="@FilterRef"></VoterFilterSimple>;

    private RenderFragment List => @<RegistryList @ref="ListRef" />;

    private RenderFragment Grid => @<RegistryGrid @ref="ListRef" />;
}