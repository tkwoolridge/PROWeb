@page "/assessments"
@using PROWeb.Components.Assessments.Filters;
@using PROWeb.Components.Assessments;
@using PROWeb.Components.Assessments.ViewModels;
@using PROWeb.Components.Common.Layouts
@inherits PRORegistryLayout<AssessmentFilterViewModel, AssessmentViewModel>

<FilterListLayout>
    <Filter>
        <ExpansionPanel>
            <Header>
                <strong>Filter:</strong>
            </Header>
            <Content>
                <AssessmentFilterAdvanced @ref="@FilterRef" />
            </Content>
        </ExpansionPanel>
    </Filter>
    <List>
        <AssessmentsGrid @ref="ListRef" />
    </List>
</FilterListLayout>
