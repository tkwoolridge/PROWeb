@page "/registrations"
@using PROWeb.Components.Common.Layouts
@using PROWeb.Office.Shared.Registrations.Filters;
@using PROWeb.Office.Shared.Registrations.ViewModels;
@using Telerik.FontIcons;
@using PROWeb.Office.Shared.Registrations;
@attribute [Authorize]
@inherits PRORegistryLayout<RegistrationFilterModel, RegistrationViewModel>

<FilterListLayout>
    <Filter>
        <ExpansionPanel>
            <Header>
                <strong>Filter:</strong>
            </Header>
            <Content>
                <RegistrationsFilter @ref="@FilterRef" />
            </Content>
        </ExpansionPanel>
    </Filter>
    <Toolbox>
        <TelerikButtonGroup SelectionMode="@ButtonGroupSelectionMode.Single">
            <ButtonGroupToggleButton @bind-Selected="@GridSelected" Icon="@FontIcon.Rows" />
            <ButtonGroupToggleButton Icon="@FontIcon.Group" />
        </TelerikButtonGroup>
    </Toolbox>
    <List>
        @ListTemplate
    </List>
</FilterListLayout>

@code{
    private RenderFragment List => @<RegistrationsList @ref="ListRef" />;
    private RenderFragment Grid => @<RegistrationsGrid @ref="ListRef" />;
}