@{
    Layout = "_Layout.cshtml";
}
<body class="k-body">
    <div class="main-grid">
            <div class="main-header d-flex align-items-center">
                <span class="main-title ms-4">PRO OFFICE - @ViewData["Title"]</span>
            </div>
            <div class="px-4">
                @RenderBody()
            </div>
            <footer class="footer text-center d-flex justify-content-center">
               <div class="pb-0 w-100">
                    <p class="text-muted">
                        Copyright © @DateTime.Now.Year The Parliamentary Registry. All rights reserved.
                    </p>
                </div>
            </footer>
     </div>

    @RenderSection("scripts", required: false)
</body>