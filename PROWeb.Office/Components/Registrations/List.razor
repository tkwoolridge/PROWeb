@using PROWeb.Office.Components.Registrations.Filters;
@using PROWeb.Office.Components.Registrations.Views
@using PROWeb.Office.Components.Voters
@using PROWeb.Office.ViewModels.Registrations;
@using PROWeb.Office.ViewModels.Voters;
@using PROWeb.Components.Person.Filters;
@inherits PROListComponent<RegistrationFilterModel, ListRegistrationViewModel>

<style>
    .voter-view {
        float: left;
        width: 600px;
        margin: 5px;
        box-sizing: border-box;
        position: relative;
    }
</style>

<TelerikListView @ref="ListRef"
                 OnUpdate="@OnUpdate"
                 Data=@Data
                 @bind-Page="@Page"
                 Pageable="true"
                 Height="100%">
    <Template>
        <div class="voter-view">
            <CascadingValue Value="@context">
                <ListFormView />
            </CascadingValue>
        </div>
    </Template>
    <EditTemplate>
        <div class="voter-view">
            <CascadingValue Value="@context">
                <ListFormView Editable="true" />
            </CascadingValue>
        </div>
    </EditTemplate>
</TelerikListView>
