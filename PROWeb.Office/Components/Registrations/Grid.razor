@using PROWeb.Office.Components.Registrations.Filters;
@using PROWeb.Office.ViewModels.Registrations;
@using PROWeb.Office.ViewModels.Voters;
@using PROWeb.Components.Person.Filters;
@using PROWeb.Components.ViewModels.Voters;
@inherits PROListComponent<RegistrationFilterModel, ListRegistrationViewModel>;

<TelerikGrid @bind-Page="@Page"
             PageSize="@PageSize"
             Height="100%"
             Pageable="true"
             Data="@Data">
    <GridColumns>
        <GridColumn Width="90px" Field=@nameof(ListRegistrationViewModel.VoterId) Title="ID" />
        <GridColumn Width="70px" Field=@nameof(ListRegistrationViewModel.Title) Title="Title" />
        <GridColumn Width="150px" Field=@nameof(ListRegistrationViewModel.LastName) Title="Last Name" />
        <GridColumn Width="150px" Field=@nameof(ListRegistrationViewModel.FirstName) Title="First Name" />
        <GridColumn Width="150px" Field=@nameof(ListRegistrationViewModel.MiddleName) Title="Middle Name" />
        <GridColumn Width="120px" Field=@nameof(ListRegistrationViewModel.DateOfBirth) DisplayFormat="{0:dd-MMM-yyyy}" Title="DOB" />
        <GridColumn Width="50px" Field=@nameof(ListRegistrationViewModel.Age) Title="Age" />
        <GridColumn Width="50px" Field=@nameof(ListRegistrationViewModel.Gender) Title="Sex" />
        <GridColumn Width="100px" Field=@nameof(ListRegistrationViewModel.ConstituencyNo) Title="Const.#" />
        <GridColumn Field=@nameof(ListRegistrationViewModel.Address) Title="Address" />
    </GridColumns>
</TelerikGrid>