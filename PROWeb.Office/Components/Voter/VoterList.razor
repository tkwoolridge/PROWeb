@using PROWeb.Components.ViewModels.Voter
@using PROWeb.Components.Voters.Views
@inherits PROListComponent<VoterFilterViewModel, TabedVoterViewModel>

<style>
    .voter-view{
        float: left;
        width: 600px;
        margin: 5px;
        box-sizing: border-box;
        position: relative;
    }
</style>

<TelerikListView 
        OnUpdate="@OnUpdate"
        Data=@Data
        @bind-Page="@Page"
        Pageable="true"
        Height="100%">
    <Template>
        <div class="voter-view">
            <CascadingValue Value="@context">
                <VoterView/>
            </CascadingValue>
        </div>
    </Template>
    <EditTemplate>
        <div class="voter-view">
            <CascadingValue Value="@context">
                <VoterView Editable="true" />
            </CascadingValue>
        </div>
    </EditTemplate>
</TelerikListView>
