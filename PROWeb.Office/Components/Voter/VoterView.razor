@using PROWeb.Components.ViewModels.Voter;
@using PROWeb.Components.Voters.Views;
@inherits VoterView<TabedVoterViewModel>

<style>
    .voter-main-view {
        display: grid;
        grid-template-rows: auto auto 1fr;
        grid-template-columns: auto 1fr;
        gap: 5px 15px;
    }

    .voter-address-view
    {
        grid-area: 3/1 / 3/3;
        align-content: start;
    }

    .voter-details-view {
        align-content: start;
    }
</style>

<TelerikTabStrip @bind-ActiveTabIndex="@Context.TabIndex">
        <TabStripTab Title="Voter">
        @if (Editable)
        {
            @EditToolBar
        }
        else
        {
            @ViewToolBar
        }
        <div class="voter-main-view">
            <VoterPhotosView />
            <VoterDetailsView Editable="@Editable" />
            <VoterAddressView Editable="@Editable" />
        </div>
    </TabStripTab>
    <TabStripTab Title="Contact">
        @if(Editable)
        {
            @EditToolBar
        }
        else
        {
            @ViewToolBar
        }
        <VoterContactInfoView Editable="@Editable"/>
    </TabStripTab>
</TelerikTabStrip>

@code {
    protected RenderFragment ViewToolBar = @<div class="d-flex justify-content-end p-1">
                                                    <ListViewCommandButton Icon="edit" Command="Edit">Edit</ListViewCommandButton>
                                            </div>;
    protected RenderFragment EditToolBar = @<div class="d-flex justify-content-end p-1">
                                                    <ListViewCommandButton Icon="save" Command="Save" Class="me-1">Save</ListViewCommandButton> 
                                                    <ListViewCommandButton Icon="cancel"  Command="Cancel">Cancel</ListViewCommandButton>
                                            </div>;
}
