@using PROWeb.Components.Person.Filters;
@using PROWeb.Office.Components.EligiblePolls.Views;
@using PROWeb.Office.Components.EligiblePolls.Filters;
@using PROWeb.Office.ViewModels.EligiblePolls;
@inherits PRORegistryLayout<FilterModel, EligibleViewModel>

<FilterListLayout>
    <Filter>
        <ExpansionPanel>
            <Header>
                <strong>Filter:</strong>
            </Header>
            <Content>
                <EligibleFilterSimple @ref="@FilterRef" />
            </Content>
        </ExpansionPanel>
    </Filter>
    <List>
        <EligibleGrid EnableSelection="@EnableSelection" EligibleSelected="@OnSelectionChanged" @ref="ListRef" />
    </List>
</FilterListLayout>
