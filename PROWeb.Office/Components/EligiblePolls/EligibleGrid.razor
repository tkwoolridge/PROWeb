@using PROWeb.Components.Person.Filters;
@using PROWeb.Office.Components.EligiblePolls.Views;
@using PROWeb.Office.ViewModels.EligiblePolls;
@inherits PROListComponent<FilterModel, EligibleViewModel>

<style>
    .eligible-grid td.vertical-aligned-cell {
        vertical-align: top;
    }

    .eligible-grid th.align-center {
        text-align: center;
    }
</style>


<TelerikGrid Data="@Data"
             @bind-Page="@Page"
             PageSize="@PageSize"
             Class="eligible-grid"
             Height="100%"
             TItem="EligibleViewModel"
             SelectedItemsChanged="@OnSelectionChanged"
             SelectionMode="@(EnableSelection ? GridSelectionMode.Single : GridSelectionMode.None)"
             Pageable="true">
    <GridColumns>
        @if(EnableSelection)
        {
            <GridCheckboxColumn Width="30px" SelectAll="false" />
        }
        <GridColumn HeaderClass="align-center" Title="BIRTHS REGISTER" OnCellRender="@( (GridCellRenderEventArgs e) => e.Class = "vertical-aligned-cell" )">
            <Template>
                @{
                    var eligible = (EligibleViewModel) context;
                    <CascadingValue Value="@eligible">
                        <BirthView />
                     </CascadingValue>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderClass="align-center" Title="STATUS REGISTER" OnCellRender="@( (GridCellRenderEventArgs e) => e.Class = "vertical-aligned-cell" )">
            <Template>
                @{
                    var eligible = (EligibleViewModel)context;
                    <CascadingValue Value="@eligible">
                        <ImmigrationView/>
                    </CascadingValue>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderClass="align-center" Title="DRIVERS REGISTER" OnCellRender="@( (GridCellRenderEventArgs e) => e.Class = "vertical-aligned-cell" )">
            <Template>
                @{
                    var eligible = (EligibleViewModel)context;
                    <CascadingValue Value="@eligible">
                        <DriverLicenseView />
                    </CascadingValue>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</TelerikGrid>