@using PROWeb.Office.Components.EligiblePoll.Views;
@using PROWeb.Office.ViewModels.EligiblePoll;
@inherits PROView<EligibleViewModel>

<TelerikTabStrip>
    <TabStripTab Title="Details">
        <div class="drivers-license-person-view">
            <div>
                <DriverPhotoView TCDPhotoTitle="Photo"/>
            </div>
            <div>
                <DriversLicenseDetailsView Title="Driver Details:"/>
                <div class="drivers-license-id-view">
                    <label>Driver License:</label>
                    <input readonly class="k-input k-input-solid k-input-md k-rounded-md w-100" type="text" value="@Model?.DriverLicenseId" />
                </div>
            </div>
        </div>
    </TabStripTab>
    <TabStripTab Title="Address">
        <div class="drivers-license-address-view">
            <DriverLicenseAddressView/>
        </div>
    </TabStripTab>
</TelerikTabStrip>
