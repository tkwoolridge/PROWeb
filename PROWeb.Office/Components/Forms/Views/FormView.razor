@using Telerik.FontIcons;
@inherits PROComponent

<div class="d-flex justify-content-center">
    <div style="width:600px">
        <div class="d-flex justify-content-between py-2">
            <div>
                <span>Date: @DateTime.Now.ToString("dd MMM yy hh:mm")</span>
                <br/>
                <span class="k-text-error">Not Assigned</span>
            </div>
            <div class="d-flex justify-content-end align-items-center">
                <TelerikButton OnClick="@OnApprove" Class="me-1" Icon="FontIcon.Check" ThemeColor="primary" />
                <TelerikButton OnClick="@OnReject"  Class="me-1" Icon="FontIcon.Cancel" />
                <TelerikButton OnClick="@OnSave" Class="me-1" Icon="FontIcon.Save" />
                <TelerikButton OnClick="@OnUndo" Icon="FontIcon.Undo" />
            </div>
        </div>
        <div class="d-flex justify-content-center py-2">
            <span class="k-text-primary">@FormDescription</span>
        </div>
        <div class="d-flex justify-content-center py-2 pro-header my-1">
            <span>@FormName</span>
        </div>
        <div>
            @Form
        </div>
    </div>
</div>