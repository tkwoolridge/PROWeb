@using PROWeb.Office.Components.Forms.Views;
@using PROWeb.Office.Components.Forms.Views.Forms
@inherits FormWizard

<TelerikWizard @bind-Value="@Page" Height="100%" OnFinish="@OnWizardFinish">
    <WizardSteps>
        <WizardStep Label="Voters">
            <Content>
                <CascadingValue Value="@WizardModel">
                    <VoterSearchView VoterSelected="@OnVoterSelected" />
                </CascadingValue>
            </Content>
        </WizardStep>
        <WizardStep Label="Action">
            <Content>
                <CascadingValue Value="@WizardModel">
                    <RegistrationActionView/>
                </CascadingValue>
            </Content>
        </WizardStep>
        <WizardStep Label="@SecundStepLabel">
            <Content>
                <CascadingValue Value="@WizardModel">
                    @SecundStepView
                </CascadingValue>
            </Content>
        </WizardStep>
        <WizardStep Label="Review Form">
            <Content>
                <CascadingValue Value="@Registration">
                    <FormView 
                        FormDescription="CHANGE REGITRATION DETAILS" 
                        FormName="FORM 2">
                        <Form>
                            <ExpansionPanel Class="my-1">
                                <Header>
                                    <strong>VOTER PHOTOS</strong>
                                </Header>
                                <Content>
                                    <div class="d-flex justify-content-center">
                                        <FormPhotosView />
                                    </div>
                                </Content>
                            </ExpansionPanel>
                            <ExpansionPanel Class="my-1">
                                <Header>
                                    <strong>VOTER DETAILS</strong>
                                </Header>
                                <Content>
                                    <FormDetailsView />
                                </Content>
                            </ExpansionPanel>
                            <ExpansionPanel Class="my-1" IsExpanded="false">
                                <Header>
                                    <strong>OLD ADDRESS</strong>
                                </Header>
                                <Content>
                                    <FormOldAddressView />
                                </Content>
                            </ExpansionPanel>
                            <ExpansionPanel Class="my-1">
                                <Header>
                                    <strong>ADDRESS</strong>
                                </Header>
                                <Content>
                                    <FormAddressView />
                                </Content>
                            </ExpansionPanel>
                            <ExpansionPanel Class="my-1" IsExpanded="false">
                                <Header>
                                    <strong>CONTACT INFO</strong>
                                </Header>
                                <Content>
                                    <FormContactInfoView Editable="true" />
                                </Content>
                            </ExpansionPanel>
                            <ExpansionPanel Class="my-1" IsExpanded="false">
                                <Header>
                                    <strong>FLAGS</strong>
                                </Header>
                                <Content>
                                    <FormFlagsView Editable="true" />
                                </Content>
                            </ExpansionPanel>   
                        </Form>
                    </FormView>
                </CascadingValue>
            </Content>
        </WizardStep>
    </WizardSteps>
    <WizardSettings>
        <WizardStepperSettings Linear="true" StepType="@StepperStepType.Steps" />
    </WizardSettings>
    <WizardButtons>
        @{
            var index = context;
            <TelerikButton Enabled="@( index > 0 )" ButtonType="ButtonType.Button" OnClick="@ToPreviousPage">Previous</TelerikButton>
            <TelerikButton Enabled="@( index < 3 )" ButtonType="ButtonType.Button" ThemeColor="@(ThemeConstants.Button.ThemeColor.Primary)" OnClick="@ToNextPage">Next</TelerikButton>
        }
    </WizardButtons>
</TelerikWizard>

@code
{
    protected RenderFragment AddressTemplate => @<AddressSearchView AssessmentSelected="@OnAssessmentSelected"/>;
    protected RenderFragment NameChangeTemplate { get; } = @<NameChangeView />;
}
