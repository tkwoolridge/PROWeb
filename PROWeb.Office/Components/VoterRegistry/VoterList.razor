@using PROWeb.Components.ViewModels.Voter
@using PROWeb.Components.ViewModels.Person
@using PROWeb.Office.ViewModels.Voter;
@inherits PROListComponent<PersonFilterViewModel, ListVoterViewModel>

<style>
    .voter-view{
        float: left;
        width: 600px;
        margin: 5px;
        box-sizing: border-box;
        position: relative;
    }
</style>

<TelerikListView 
        OnUpdate="@OnUpdate"
        Data=@Data
        @bind-Page="@Page"
        Pageable="true"
        Height="100%">
    <Template>
        <div class="voter-view">
            <CascadingValue Value="@context">
                <ListVoterView/>
            </CascadingValue>
        </div>
    </Template>
    <EditTemplate>
        <div class="voter-view">
            <EditForm Model="@context" Context="formContext">
                <DataAnnotationsValidator />
                <ListVoterView />
            </EditForm>
        </div>
    </EditTemplate>
</TelerikListView>