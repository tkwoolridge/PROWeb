@using PROWeb.Office.ViewModels.Voters;
@using PROWeb.Components.Person.Filters;
@inherits PROListComponent<FilterModel, ListVoterViewModel>

<style>
    .voter-view{
        float: left;
        width: 600px;
        margin: 5px;
        box-sizing: border-box;
        position: relative;
    }
</style>

<TelerikListView 
        @ref="ListRef"
        OnUpdate="@OnUpdate"
        Data=@Data
        @bind-Page="@Page"
        Pageable="true"
        Height="100%">
    <Template>
        <div class="voter-view">
            <CascadingValue Value="@context">
                <ListVoterView/>
            </CascadingValue>
        </div>
    </Template>
    <EditTemplate>
        <div class="voter-view">
           <CascadingValue Value="@context">
                <ListVoterView Editable="true"/>
            </CascadingValue>
        </div>
    </EditTemplate>
</TelerikListView>