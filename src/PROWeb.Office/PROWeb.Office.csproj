
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Shared\Reports\**" />
    <Content Remove="Shared\Reports\**" />
    <EmbeddedResource Remove="Shared\Reports\**" />
    <None Remove="Shared\Reports\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot\reports\ElectionCertificate.trdp" />
    <Content Remove="wwwroot\reports\ImmigrationCertificate.trdp" />
    <Content Remove="wwwroot\reports\VotersAtoZ.trdp" />
    <Content Remove="wwwroot\reports\VotersWithDOB.trdp" />
    <Content Remove="wwwroot\reports\WalkList.trdp" />
    <Content Remove="wwwroot\reports\WalkListWithDOB.trdp" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="IISUrlRewrite.xml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CompareNETObjects" Version="4.84.0" />
    <PackageReference Include="Mapster" Version="7.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Telerik.UI.for.Blazor" Version="11.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PROWeb.Authentication\PROWeb.Authentication.csproj" />
    <ProjectReference Include="..\PROWeb.Components\PROWeb.Components.csproj" />
    <ProjectReference Include="..\PROWeb.Data\PROWeb.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="wwwroot\reports\ElectionCertificate.trdp" />
    <None Include="wwwroot\reports\VotersAtoZ.trdp" />
    <None Include="wwwroot\reports\ImmigrationCertificate.trdp" />
    <None Include="wwwroot\reports\WalkListWithDOB.trdp" />
    <None Include="wwwroot\reports\WalkList.trdp" />
    <None Include="wwwroot\reports\VotersWithDOB.trdp" />
    <None Include="wwwroot\reports\Voters.trdp" />
  </ItemGroup>
</Project>
