@using PROWeb.Components.Common.Layouts;
@using PROWeb.Components.Common.Views;
@using PROWeb.Components.Person
@using PROWeb.Data.Models.Enums
@using PROWeb.Office.Registrations.Views
@using PROWeb.Office.Shared.Registrations.ViewModels;
@using Telerik.FontIcons;
@inherits FormViewBase;

<style>
    .ep-container {
        border: 1px solid black;
        border-radius: 2px;
    }

    .ep-header {
        background-color: rgba(255, 255, 255, 0.5);
        color: black;
    }

    .form1-background {
        background-color: #B3E49F;
        border-radius: 5px;
    }

    .form2-background {
        background-color: #CDE6F6;
        border-radius: 5px;
    }
</style>

<div class="d-flex justify-content-center h-100">
    <div style="width:600px;" class="@Class p-2 h-100">
        <div class="h-100">
            <ViewsLayout TViewModel="RegistrationViewModel" Editable="true" @ref="LayoutRef">
                <Header>
                    <div class="d-flex justify-content-between py-2">
                        <div>
                            @if (Model?.LastUpdated is { } lastUpdated)
                            {
                                <span class="k-text-info">
                                    Date: @(lastUpdated.ToString("dd MMM yy hh:mm"))
                                </span>
                            }
                            else
                            {
                                <span class="k-text-error">Not Assigned</span>
                            }
                            
                            <br />
                            <span>Last Updated By: </span>
                            @if(Model?.LastUpdatedBy is { } userName)
                            {
                                <span class="k-text-info">@userName</span>
                            }
                            else
                            {
                                <span class="k-text-error">Not Assigned</span>
                            }
                        </div>
                        <div class="d-flex justify-content-end align-items-center">
                            <TelerikButton OnClick="@OnApproveAsync" Enabled="@CanApprove" Class="me-1" Icon="FontIcon.Check" />
                            <TelerikButton OnClick="@OnRejectAsync" Enabled="@CanReject" Class="me-1" Icon="FontIcon.Cancel" />
                            <TelerikButton OnClick="@OnSaveAsync" Enabled="@CanSave" Class="me-1" Icon="FontIcon.Save" />
                            <TelerikButton OnClick="@OnUndo" Enabled="@CanUndo" Icon="FontIcon.Undo" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-center py-2">
                        <span class="k-text-primary">@FormDescription</span>
                    </div>
                    <div class="d-flex justify-content-center py-2 form-header my-1">
                        <span>@FormName</span>
                    </div>
                </Header>
                <Views>
                    @switch ((FormTypes)Model!.FormTypeId)
                    {
                        case (FormTypes.Form1):
                            {
                                 <ExpansionPanel Class="my-1">
                                    <Header>
                                        <strong>VOTER PHOTOS</strong>
                                    </Header>
                                    <Content>
                                        <div class="d-flex justify-content-center">
                                            <FormPhotosView />
                                        </div>
                                    </Content>
                                </ExpansionPanel>
                                <ExpansionPanel Class="my-1">
                                    <Header>
                                        <strong>VOTER DETAILS</strong>
                                    </Header>
                                    <Content>
                                        <FormDetailsView AddressView="AddressViewRef"
                                                         ShowPopulateDialogButton="true"
                                                         PopulateDialog="PopulateDetailsDialogs.EligiblePolls"
                                                         Editable="true" />
                                    </Content>
                                </ExpansionPanel>
                                <ExpansionPanel Class="my-1">
                                    <Header>
                                        <strong>ADDRESS</strong>
                                    </Header>
                                    <Content>
                                        <FormAddressView ShowPopulateDialogButton="true" @ref="AddressViewRef" />
                                    </Content>
                                </ExpansionPanel>
                                <ExpansionPanel Class="my-1" IsExpanded="false">
                                    <Header>
                                        <strong>CONTACT INFO</strong>
                                    </Header>
                                    <Content>
                                        <FormContactInfoView Editable="true" />
                                    </Content>
                                </ExpansionPanel>
                                <ExpansionPanel Class="my-1" IsExpanded="false">
                                    <Header>
                                        <strong>FLAGS</strong>
                                    </Header>
                                    <Content>
                                        <FormFlagsView Editable="true" />
                                    </Content>
                                </ExpansionPanel>
                                break;
                            }
                        case (FormTypes.Form2):
                            {
                                <ExpansionPanel Class="my-1">
                                    <Header>
                                        <strong>VOTER PHOTOS</strong>
                                    </Header>
                                    <Content>
                                        <div class="d-flex justify-content-center">
                                            <FormPhotosView />
                                        </div>
                                    </Content>
                                </ExpansionPanel>
                                <ExpansionPanel Class="my-1">
                                    <Header>
                                        <strong>VOTER DETAILS</strong>
                                    </Header>
                                    <Content>
                                        <FormDetailsView Editable="false"
                                                         AllowLastNameEdit="true"
                                                         ShowPopulateDialogButton="true"
                                                         ShowMaidenName="true"
                                                         PopulateDialog="PopulateDetailsDialogs.Voters"
                                                         ContactInfoView="@ContactInfoViewRef"
                                                         AddressView="@AddressViewRef"
                                                         OldAddressView="@OldAddressViewRef"
                                                         FlagsView="@FormFlagsViewRef" />
                                    </Content>
                                </ExpansionPanel>
                                <ExpansionPanel Class="my-1" IsExpanded="false">
                                    <Header>
                                        <strong>OLD ADDRESS</strong>
                                    </Header>
                                    <Content>
                                        <FormOldAddressView Editable="false" @ref="@OldAddressViewRef" />
                                    </Content>
                                </ExpansionPanel>
                                <ExpansionPanel Class="my-1">
                                    <Header>
                                        <strong>ADDRESS</strong>
                                    </Header>
                                    <Content>
                                        <FormAddressView ShowPopulateDialogButton="true" @ref="@AddressViewRef" />
                                    </Content>
                                </ExpansionPanel>
                                <ExpansionPanel Class="my-1" IsExpanded="false">
                                    <Header>
                                        <strong>CONTACT INFO</strong>
                                    </Header>
                                    <Content>
                                        <FormContactInfoView Editable="true" @ref="@ContactInfoViewRef" />
                                    </Content>
                                </ExpansionPanel>
                                <ExpansionPanel Class="my-1" IsExpanded="false">
                                    <Header>
                                        <strong>FLAGS</strong>
                                    </Header>
                                    <Content>
                                        <FormFlagsView @ref="FormFlagsViewRef" Editable="true" />
                                    </Content>
                                </ExpansionPanel>
                                break;
                            }
                    }
                </Views>
                <Footer>
                    @FormFooter
                </Footer>
            </ViewsLayout>
        </div>
    </div>
</div>