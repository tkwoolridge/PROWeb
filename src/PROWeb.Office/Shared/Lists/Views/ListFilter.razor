@using PROWeb.Office.Shared.Lists.ViewModels
@inherits PROFilterComponent<ListFilterViewModel>

<EditForm FormName="listFilter" Model="@Filter">
    <div class="d-flex justify-content-start">
        <div class="list-filter">
            <label for="lastName" class="k-label k-form-label">Description:</label>
            <TelerikTextBox Id="lastName" @bind-Value="@Filter.Description" />
        </div>
    </div>
    <div class="d-flex justify-content-between w-100 mt-2">
        <TelerikButton Class="w-75 me-1" ButtonType="@ButtonType.Submit" OnClick="@OnSearchAsync" Enabled="@CanSearch" ThemeColor="primary">Search</TelerikButton>
        <TelerikButton Class="w-25 ms-1" ButtonType="ButtonType.Reset" OnClick="@OnClear">Clear</TelerikButton>
    </div>
</EditForm>