@using PROWeb.Components.Person.Filters;
@using PROWeb.Components.Voters.ViewModels;
@using PROWeb.Office.Shared.Registrations
@using PROWeb.Office.Shared.Registry.Views
@inherits PROListComponent<FilterModel, VoterViewModel>;

<TelerikContextMenu @ref="@ContextMenu" Data="@MenuItems" OnClick="@((MenuItem item) => OnItemClick(item))" />

    <TelerikSplitter Orientation="SplitterOrientation.Horizontal" Height="100%">
        <SplitterPanes>
            <SplitterPane Collapsible="false">
                <TelerikGrid @bind-Page="@Page"
                             @ref="@GridRef"
                             PageSize="@PageSize"
                             Height="100%"
                             ShowColumnMenu="true"
                             SelectionMode="GridSelectionMode.Single"
                             SelectedItemsChanged="@( (IEnumerable<VoterViewModel> voters) => OnSelectionChanged(voters.First()) )"
                             OnRowContextMenu="@OnRowContextMenu"
                             Pageable="true"
                             Data="@Data">
                    <GridColumns>
                        <GridColumn Width="90px" Field=@nameof(VoterViewModel.VoterId) Title="ID" />
                        <GridColumn Width="70px" Field=@nameof(VoterViewModel.Title) Title="Title" />
                        <GridColumn Width="150px" Field=@nameof(VoterViewModel.LastName) Title="Last Name" />
                        <GridColumn Width="150px" Field=@nameof(VoterViewModel.FirstName) Title="First Name" />
                        <GridColumn Width="150px" Field=@nameof(VoterViewModel.MiddleName) Title="Middle Name" />
                        <GridColumn Width="120px" Field=@nameof(VoterViewModel.DateOfBirth) DisplayFormat="{0:dd-MMM-yyyy}" Title="DOB" />
                        <GridColumn Width="70px" Field=@nameof(VoterViewModel.Age) Title="Age" />
                        <GridColumn Width="70px" Field=@nameof(VoterViewModel.Gender) Title="Sex" />
                        <GridColumn Width="100px" Field=@nameof(VoterViewModel.ConstituencyNo) Title="Const.#" />
                        <GridColumn Width="100px" Field=@nameof(VoterViewModel.IsEligible) FieldType="@typeof(bool)" Title="Eligible" />
                        <GridColumn Field=@nameof(VoterViewModel.Address) Title="Address" />
                    </GridColumns>
                </TelerikGrid>
            </SplitterPane>
           <SplitterPane Collapsible="true" @bind-Collapsed="@VoterViewCollapsed" Resizable="false" Size="450px">
                <CascadingValue Value="@SelectedVoter" IsFixed="true">
                <VoterView @key="SelectedVoter?.VoterId" OnVoterSaved="@OnVoterSaved" />
                </CascadingValue>
            </SplitterPane>
    </SplitterPanes>
</TelerikSplitter>

<FormDialog @ref="@FormDialogRef" Model="@FormModel" />