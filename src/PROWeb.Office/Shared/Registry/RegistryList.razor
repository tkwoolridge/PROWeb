@using PROWeb.Components.Voters.ViewModels;
@using PROWeb.Components.Person.Filters;
@using PROWeb.Office.Shared.Registry.Views
@inherits PROListComponent<FilterModel, VoterViewModel>

<style>
    .voter-view{
        float: left;
        width: 600px;
        margin: 5px;
        box-sizing: border-box;
        position: relative;
    }
</style>

<TelerikListView
        @ref="ListRef"
        OnUpdate="@OnUpdate"
        Data=@Data
        @bind-Page="@Page"
        Pageable="true"
        Height="100%">
    <Template>
        <div class="voter-view">
            <CascadingValue Value="@context">
                <VoterTabView/>
            </CascadingValue>
        </div>
    </Template>
    <EditTemplate>
        <div class="voter-view">
           <CascadingValue Value="@context">
                <VoterTabView Editable="true"/>
            </CascadingValue>
        </div>
    </EditTemplate>
</TelerikListView>