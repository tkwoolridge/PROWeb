@page "/registrations"
@using PROWeb.Components.Common.Layouts
@using PROWeb.Office.Shared.Registrations.Filters;
@using PROWeb.Office.Shared.Registrations.ViewModels;
@using Telerik.FontIcons;
@using PROWeb.Office.Shared.Registrations;
@attribute [Authorize]
@inherits PRORegistryLayout<RegistrationFilterModel, RegistrationViewModel>

<FilterListLayout>
    <Filter>
        <ExpansionPanel>
            <Header>
                <strong>Filter:</strong>
            </Header>
            <Content>
                <RegistrationsFilter @ref="@FilterRef" />
            </Content>
        </ExpansionPanel>
    </Filter>
    <List>
        <div class="p-container h-100">
            <RegistrationsGrid @ref="ListRef" />
        </div>
    </List>
    <Footer>
        <div class="d-flex justify-content-end  align-items-center w-100 p-container p-2">
            <img class="me-2" style="width: 40px" src="/images/form1.png" />
            <span class="me-2"><b>P:</b> @PendingForm1Count <b>A:</b> @ApprovedForm1Count  <b>T:</b> @Form1Total</span>
            <img class="me-2" style="width: 40px" src="/images/form2.png" />
            <span class="me-2"><b>P:</b> @PendingForm2Count <b>A:</b> @ApprovedForm2Count  <b>T:</b> @Form2Total</span>
        </div>
    </Footer>
</FilterListLayout>