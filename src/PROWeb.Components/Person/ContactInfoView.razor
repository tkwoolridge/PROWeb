@using PROWeb.Common.ViewModels;
@inherits ContactInfoViewBase<TContactInfoViewModel>
@typeparam TContactInfoViewModel

<EditForm EditContext="@EditContext">
   <DataAnnotationsValidator />
    <div class="contact-info-view">
        <div class="contact-info-title pro-view-title mb-2">@Title</div>
        <label>Home Phone:</label>
        <TelerikTextBox ReadOnly="@ReadOnly" @bind-Value="@ContactInfoContext.PhoneHome" />

        <label>Work Phone:</label>
        <TelerikTextBox ReadOnly="@ReadOnly" @bind-Value="@ContactInfoContext.PhoneWork" />

        <label>Contact Phone:</label>
        <TelerikTextBox ReadOnly="@ReadOnly" @bind-Value="@ContactInfoContext.ContactPhone" Id="@(nameof(ContactInfoContext.ContactPhone))" />
        <TelerikValidationTooltip For="@(() => ContactInfoContext.ContactPhone)" TargetSelector="@("#" + nameof(ContactInfoContext.ContactPhone))" />

        <label>Driver License:</label>
        <TelerikTextBox ReadOnly="@ReadOnly" @bind-Value="@ContactInfoContext.DriverLicense" />
        <TelerikValidationTooltip For="@(() => ContactInfoContext.DriverLicense)" TargetSelector="@("#" + nameof(ContactInfoContext.DriverLicense))" />

        <div class="contact-email-comment-view">
            <label>Email:</label>
            <TelerikTextBox ReadOnly="@ReadOnly" @bind-Value="@ContactInfoContext.Email" Id="@(nameof(ContactInfoContext.Email))" />
            <TelerikValidationTooltip For="@(() => ContactInfoContext.Email)" TargetSelector="@("#" + nameof(ContactInfoContext.Email))" />

            <label>Comment:</label>
            <span class="k-textarea k-input telerik-blazor k-input-solid k-rounded-md k-input-md">
                <TelerikTextArea ReadOnly="@ReadOnly" @bind-Value="@ContactInfoContext.Comment" />
            </span>
        </div>
    </div>
</EditForm>