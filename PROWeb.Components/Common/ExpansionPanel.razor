@inherits PROComponentBase;

<div class="ep-container @Class">
    <div class="w-100 ep-header p-2 d-flex justify-content-between">
        <div>@Header</div>
        <div>@ToolBar</div>
        @if(IsExpanderVisible)
        {
            <span @onclick="@OnExpand" @onclick:stopPropagation class="k-icon @ArrowClass" style="line-height: inherit; margin: 0 8px"></span>
        }
    </div>
    <div class="p-2 @HideContentClass">
        @Content
    </div>
</div>


<style>
    .hide-content
    {
        display: none;
    }
</style>
