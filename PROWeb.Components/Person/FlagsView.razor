@using PROWeb.Common.ViewModels;
@using PROWeb.Components.Person.Contexts;
@typeparam TFlagsViewModel
@typeparam TFlagViewModel
@inherits FlagsViewBase<TFlagsViewModel, TFlagViewModel>;

<EditForm EditContext="@EditContext">
    <div class="person-flags-view">
        <div class="person-flags-title pro-view-title">@Title</div>
        <div>
            <label>Flags:</label>
            <TelerikMultiSelect Enabled="@Editable"
                ValueField="@(nameof(FlagContext<TFlagViewModel>.FlagId))"
                TextField="@(nameof(FlagContext<TFlagViewModel>.FlagDescription))"
                Data="@Flags" @bind-Value="@FlagsValues" />
        </div>
        <div>
            <TelerikCheckBox Id="@(nameof(FlagsContext<TFlagsViewModel,TFlagViewModel>.CommonwealthCitizen))" Enabled="@Editable" @bind-Value="@Context.CommonwealthCitizen" />
            <label for="@(nameof(FlagsContext<TFlagsViewModel,TFlagViewModel>.CommonwealthCitizen))">Is Commonwealth Citizen</label>
        </div>
        <div>
            <TelerikCheckBox Id="@(nameof(FlagsContext<TFlagsViewModel,TFlagViewModel>.RegisteredAsElector))" Enabled="@Editable" @bind-Value="@Context.RegisteredAsElector" />
            <label for="@(nameof(FlagsContext<TFlagsViewModel,TFlagViewModel>.RegisteredAsElector))">Registered As Elector</label>
        </div>
        <div class="d-flex align-items-center">
            <div class="me-2">
                <TelerikCheckBox Id="@(nameof(FlagsContext<TFlagsViewModel,TFlagViewModel>.IsBermudianStatusGranted))" Enabled="@Editable" @bind-Value="@Context.IsBermudianStatusGranted" />
                <label for="@(nameof(FlagsContext<TFlagsViewModel,TFlagViewModel>.IsBermudianStatusGranted))">Status Granted</label>
            </div>
            <div>
                <TelerikDateInput @bind-Value="@Context.BermudianStatusGranted" />
            </div>
        </div>
    </div>
</EditForm>
