@using PROWeb.Common.ViewModels;
@using PROWeb.Components.Person.Contexts;
@using Telerik.FontIcons;
@using PROWeb.Components.EligiblePolls;
@using PROWeb.Components.Voters;
@inherits DetailsViewBase<TPersonViewModel>
@typeparam TPersonViewModel

<EditForm EditContext="@EditContext">
    <DataAnnotationsValidator />
    <div class="@_viewClass">
        <div class="person-details-title pro-view-title mb-2">@Title</div>

        <label>Last Name:</label>
        <TelerikTextBox ReadOnly="@ReadOnly" @bind-Value="@DetailsContext.LastName" Id="@(nameof(DetailsContext.LastName))" />
        <TelerikValidationTooltip For="@(() => DetailsContext.LastName)" TargetSelector="@("#" + nameof(DetailsContext.LastName))" />
        
        <label>Middle Name:</label>
        <TelerikTextBox ReadOnly="@ReadOnly" @bind-Value="@DetailsContext.MiddleName" Id="@(nameof(DetailsContext.MiddleName))" />

        <label>First Name:</label>
        <TelerikTextBox ReadOnly="@ReadOnly" @bind-Value="@DetailsContext.FirstName" Id="@(nameof(DetailsContext.FirstName))" />
        <TelerikValidationTooltip For="@(() => DetailsContext.FirstName)" TargetSelector="@("#" + nameof(DetailsContext.FirstName))" />
        
        @if (ShowMaidenName)
        {
            <label>Maiden Name:</label>
            <TelerikTextBox ReadOnly="@ReadOnly" @bind-Value="@DetailsContext.MaidenName" />
        }

        <label>DOB:</label>
        @if (ShowPopulateDialogButton)
        {
            <div class="update-view">
                <div>
                    <TelerikDateInput ReadOnly="@ReadOnly" @bind-Value="@DetailsContext.DateOfBirth" Id="@(nameof(DetailsContext.DateOfBirth))" />
                    <TelerikValidationTooltip For="@(() => DetailsContext.DateOfBirth)" TargetSelector="@("#" + nameof(DetailsContext.DateOfBirth))" />
                </div>
                <TelerikButton Class="edit-update-button" OnClick="@OnUpdate" Icon="@FontIcon.User" />
            </div>
        }
        else
        {
            <div>
                <TelerikDateInput ReadOnly="@ReadOnly" @bind-Value="@DetailsContext.DateOfBirth" Id="@(nameof(DetailsContext.DateOfBirth))" />
                <TelerikValidationTooltip For="@(() => DetailsContext.DateOfBirth)" TargetSelector="@("#" + nameof(DetailsContext.DateOfBirth))" />
            </div>
        }
    </div>
</EditForm>

@if(PopulateDialog == PopulateDetailsDialogs.EligiblePolls)
{
    <EligiblePollsDialog @ref="@EligiblePollsDialogRef" Confirm="@OnEligibleSelectionConfirm" />
}
else
{
    <VoterRegistryDialog @ref="@VoterRegistryDialogRef" Confirm="@OnVoterSelectionConfirm" />
}
