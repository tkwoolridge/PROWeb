@using PROWeb.Common.ViewModels;
@using PROWeb.Components.Person.Contexts;
@using PROWeb.Components.Assessments.ViewModels;
@using PROWeb.Components.Person.Filters
@using PROWeb.Common.Components
@using Telerik.Blazor
@typeparam TFlagViewModel where TFlagViewModel : SlimViewModelBase, new()
@inherits FilterAdvancedBase<TFlagViewModel>

<EditForm Model="@Filter">
    <div class="d-flex justify-content-start">
        <div class="person-filter-advanced">

            @*Column 1*@
            <label for="lastName" class="k-label k-form-label">Last Name:</label>
            <label for="firstName" class="k-label k-form-label">First Name:</label>
            <label for="middleName" class="k-label k-form-label">Middle Name:</label>
            <label for="dateOfBirth" class="k-label k-form-label">Date Of Birth:</label>
            <label class="k-label k-form-label">Age:</label>

            <TelerikTextBox Id="lastName" @bind-Value="@Filter.LastName" />
            <TelerikTextBox Id="firstName" @bind-Value="@Filter.FirstName" />
            <TelerikTextBox Id="middleName" @bind-Value="@Filter.MiddleName" />

            <div class="d-flex justify-content-start align-items-center">
                <TelerikDateInput Id="dateOfBirth" @bind-Value="@Filter.DateOfBirth" Format="MM/dd/yyyy" />
                <TelerikCheckBox Class="mx-2" Id="isEligible" @bind-Value="@Filter.IsEligible" Title="Is Elegible" />
                <label for="isEligible">Eligible</label>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <TelerikNumericTextBox Id="ageFrom" @bind-Value="@Filter.AgeFrom" />
                <label class="mx-1">To</label>
                <TelerikNumericTextBox Id="ageTo" @bind-Value="@Filter.AgeTo" />
            </div>

            @*Column 2*@
            <label for="phone" class="k-label k-form-label">Phone:</label>
            <label for="assessmentNo" class="k-label k-form-label">Ass No:</label>
            <label class="k-label k-form-label">Street:</label>
            <label for="constituency" class="k-label k-form-label">Constituency:</label>
            <label class="k-label k-form-label">Parish:</label>

            <TelerikTextBox Id="phone" @bind-Value="@Filter.Phone" />
            <TelerikNumericTextBox Id="assessmentNo" @bind-Value="@Filter.AssessmentNo" />
            <div class="d-flex justify-content-between align-items-center">
                <TelerikTextBox Class="w-25 me-1" @bind-Value="@Filter.HouseNo" />
                <TelerikTextBox  @bind-Value="@Filter.StreetName" />
            </div>
            <TelerikComboBox Id="constituency"
                             TextField="@nameof(ConstituencyViewModel.Constituency)"
                             ValueField="@nameof(ConstituencyViewModel.ConstituencyNo)"
                             @bind-Value="@Filter.ConstituencyNo"
                             Data="@Constituencies" />
            <div class="d-flex justify-content-between align-items-center">
                <TelerikTextBox Class="w-25 me-1" @bind-Value="@Filter.PostalCode" />
                <TelerikComboBox Id="parish"
                                 TextField="@nameof(ParishViewModel.ParishName)"
                                 ValueField="@nameof(ParishViewModel.ParishNo)"
                                 @bind-Value="@Filter.ParishNo"
                                 Data="@Parishes" />
            </div>

            @*Column 3*@
            <label for="registryYear:" class="k-label k-form-label">Registry Year:</label>
            <label for="voterFlags" class="k-label k-form-label">Flags:</label>
            <div />
            <div />
            <div />

            <TelerikComboBox Id="registryYear" @bind-Value="@Filter.RegistryYear" Data="@RegistrationYears" />

            <div class="person-filter-flags">
                <TelerikMultiSelect Data="@Flags"
                                    Placeholder="Select flags..."
                                    Id="voterFlags" @bind-Value="@Filter.Flags"
                                    TextField="@nameof(FlagContext<TFlagViewModel>.FlagDescription)"
                                    ValueField="@nameof(FlagContext<TFlagViewModel>.FlagId)" />
            </div>

        </div>
    </div>
    <div class="d-flex justify-content-between w-100 mt-2">
        <TelerikButton Class="w-75 me-1" ButtonType="@ButtonType.Submit" OnClick="@OnSearchAsync" Enabled="@CanSearch" ThemeColor="primary">Search</TelerikButton>
        <TelerikButton Class="w-25 ms-1" ButtonType="ButtonType.Reset" OnClick="@OnClear">Clear</TelerikButton>
    </div>
</EditForm>

