@using PROWeb.Common.Components;
@using PROWeb.Components.Assessments.ViewModels;
@using PROWeb.Components.Person.Filters;
@inherits PROFilterComponentWithState<FilterModel>

<EditForm FormName="SimplePersonFilter" Model="@Filter">
    <div class="d-flex justify-content-start">
        <div class="person-filter-simple">
            <label for="lastName" class="k-label k-form-label">Last Name:</label>
            <TelerikTextBox Id="lastName" @bind-Value="@Filter.LastName" />

            <label for="firstName" class="k-label k-form-label">First Name:</label>
            <TelerikTextBox Id="firstName" @bind-Value="@Filter.FirstName" />

            <label for="middleName" class="k-label k-form-label">Middle Name:</label>
            <TelerikTextBox Id="middleName" @bind-Value="@Filter.MiddleName" />

            <label for="dateOfBirth" class="k-label k-form-label">Date Of Birth:</label>
            <TelerikDateInput Id="dateOfBirth" @bind-Value="@Filter.DateOfBirth" Format="MM/dd/yyyy" />
        </div>
    </div>
    <div class="d-flex justify-content-between w-100 mt-2">
        <TelerikButton Class="w-75 me-1" ButtonType="@ButtonType.Submit" OnClick="@OnSearchAsync" Enabled="@CanSearch" ThemeColor="primary">Search</TelerikButton>
        <TelerikButton Class="w-25 ms-1" ButtonType="ButtonType.Reset" OnClick="@OnClear">Clear</TelerikButton>
    </div>
</EditForm>
