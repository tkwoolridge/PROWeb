@using PROWeb.Components.ViewModels.Assessment;
@using PROWeb.Components.Assessments;
@typeparam TAddressViewModel where TAddressViewModel : class, IAddressViewModel
@inherits AddressViewBase<TAddressViewModel>

<div class="address-view">
    <div class="address-title pro-view-title w-100">@Title</div>
    <input type="textbox" readonly class="address-assessment k-input k-input-solid k-input-md k-rounded-md w-100" value="@Context.AssessmentNo" />
    <input type="textbox" readonly class="@(Editable? "address-address1-edit" : "address-address1" ) k-input k-input-solid k-input-md k-rounded-md w-100" value="@Context.Address1" />
    @if (Editable)
    {
        <TelerikButton Class="open-assesment-dialog" OnClick="@OnUpdate" Icon="home" />
    }
    <input type="textbox" readonly class="w-100 k-input k-input-solid k-input-md k-rounded-md w-100" value="@Context.HouseNo" />
    <input type="textbox" readonly class="address-address2 k-input k-input-solid k-input-md k-rounded-md w-100" value="@Context.Address2" />
    <input type="textbox" readonly class="address-postal-code k-input k-input-solid k-input-md k-rounded-md w-100" value="@Context.PostalCode" />
    <input type="textbox" readonly class="address-parish k-input k-input-solid k-input-md k-rounded-md w-100" value="@Context.ParishName" />
    <input type="textbox" readonly class="address-country k-input k-input-solid k-input-md k-rounded-md w-100" value="@Context.ConstituencyName" />
    <input type="textbox" readonly class="k-input k-input-solid k-input-md k-rounded-md w-100" value="@Context.ConstituencyNo" />
    <input type="textbox" readonly class="address-constituency k-input k-input-solid k-input-md k-rounded-md w-100" value="@Context.ConstituencyName" />
</div>

<AssessmentRegistryDialog @ref="@AssessmentRegistryDialogRef" Confirm="@OnAssessmentSelectionConfirm" />
