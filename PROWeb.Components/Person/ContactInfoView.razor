@using PROWeb.Common.ViewModels;
@inherits ContactInfoViewBase<TContactInfoViewModel>
@typeparam TContactInfoViewModel

<EditForm EditContext="@EditContext">
   <DataAnnotationsValidator />
    <div class="contact-info-view">
        <div class="contact-info-title pro-view-title mb-2">@Title</div>
        <label>Home Phone:</label>
        @if(!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@ContactInfoContext.PhoneHome" />
        }
        else
        {
            <TelerikTextBox @bind-Value="@ContactInfoContext.PhoneHome"/>
        }
        <label>Work Phone:</label>
        @if (!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@ContactInfoContext.PhoneWork" />
        }
        else
        {
            <TelerikTextBox @bind-Value="@ContactInfoContext.PhoneWork" />
        }
        <label>Contact Phone:</label>
        @if (!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@ContactInfoContext.ContactPhone"/>
        }
        else
        {
            <TelerikTextBox @bind-Value="@ContactInfoContext.ContactPhone" Id="@(nameof(ContactInfoContext.ContactPhone))" />
            <TelerikValidationTooltip For="@(() => ContactInfoContext.ContactPhone)" TargetSelector="@("#" + nameof(ContactInfoContext.ContactPhone))" />
        }
        <label>Driver License:</label>
        @if (!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@ContactInfoContext.DriverLicense" />
        }
        else
        {
            <TelerikTextBox @bind-Value="@ContactInfoContext.DriverLicense" />
            <TelerikValidationTooltip For="@(() => ContactInfoContext.DriverLicense)" TargetSelector="@("#" + nameof(ContactInfoContext.DriverLicense))" />
        }
        <div class="contact-email-comment-view">
            <label>Email:</label>
            @if (!Editable)
            {
                <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@ContactInfoContext.Email" />
            }
            else
            {
                <TelerikTextBox @bind-Value="@ContactInfoContext.Email" Id="@(nameof(ContactInfoContext.Email))" />
                <TelerikValidationTooltip For="@(() => ContactInfoContext.Email)" TargetSelector="@("#" + nameof(ContactInfoContext.Email))" />
            }
            <label>Comment:</label>
            <span class="k-textarea k-input telerik-blazor k-input-solid k-rounded-md k-input-md">
            @if (!Editable)
            {
                <textarea readonly aria-multiline="true" class="k-input-inner">@ContactInfoContext.Comment</textarea>
            }
            else
            {
                <TelerikTextArea @bind-Value="@ContactInfoContext.Comment" />
            }
            </span>
        </div>
    </div>
</EditForm>