@using PROWeb.Common.ViewModels;
@using PROWeb.Components.ViewModels.Person;
@typeparam TPersonFlagsViewModel where TPersonFlagsViewModel : class, IPersonFlagsViewModel<TPersonFlagViewModel>
@typeparam TPersonFlagViewModel where TPersonFlagViewModel : ViewModelBase,IPersonFlagViewModel, new()
@inherits PersonFlagsViewBase<TPersonFlagsViewModel, TPersonFlagViewModel>;

<div class="person-flags-view">
    <div class="person-flags-title pro-view-title">@Title</div>
    <div>
        <label>Flags:</label>
        <TelerikMultiSelect Enabled="@Editable"
            ValueField="@(nameof(IPersonFlagViewModel.FlagId))"
            TextField="@(nameof(IPersonFlagViewModel.FlagDescription))"
            Data="@Flags" @bind-Value="@FlagsValues" />
    </div>
    <div>
        <TelerikCheckBox Id="@(nameof(IPersonFlagsViewModel<TPersonFlagViewModel>.CommonwealthCitizen))" Enabled="@Editable" @bind-Value="@Context.CommonwealthCitizen" />
        <label for="@(nameof(IPersonFlagsViewModel<TPersonFlagViewModel>.CommonwealthCitizen))">Is Commonwealth Citizen</label>
    </div>
    <div>
        <TelerikCheckBox Id="@(nameof(IPersonFlagsViewModel<TPersonFlagViewModel>.RegisteredAsElector))" Enabled="@Editable" @bind-Value="@Context.RegisteredAsElector" />
        <label for="@(nameof(IPersonFlagsViewModel<TPersonFlagViewModel>.RegisteredAsElector))">Registered As Elector</label>
    </div>
    <div class="d-flex align-items-center">
        <div class="me-2">
            <TelerikCheckBox Id="@(nameof(IPersonFlagsViewModel<TPersonFlagViewModel>.IsBermudianStatusGranted))" Enabled="@Editable" @bind-Value="@Context.IsBermudianStatusGranted" />
            <label for="@(nameof(IPersonFlagsViewModel<TPersonFlagViewModel>.IsBermudianStatusGranted))">Status Granted</label>
        </div>
        <div>
            <TelerikDateInput @bind-Value="@Context.BermudianStatusGranted" />
        </div>
    </div>
</div>
