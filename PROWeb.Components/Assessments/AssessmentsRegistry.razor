@using PROWeb.Components.Assessments.ViewModels;
@using PROWeb.Components.Assessments.Filters;
@using PROWeb.Components.Common.Layouts
@inherits PRORegistryLayout<AssessmentFilterViewModel, AssessmentViewModel>

<FilterListLayout>
    <Filter>
        <ExpansionPanel>
            <Header>
                <strong>Filter:</strong>
            </Header>
            <Content>
                <AssessmentFilterAdvanced PersistState="@PersistState" @ref="@FilterRef" />
            </Content>
        </ExpansionPanel>
    </Filter>
    <List>
        <AssessmentsGrid PersistState="@PersistState" EnableSelection="@EnableSelection" AssessmentSelected="@OnSelectionChanged" @ref="@ListRef" />
    </List>
</FilterListLayout>