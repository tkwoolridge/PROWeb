@inherits PROContentLayout
@typeparam TViewModel

<div class="views-layout">
    <div class="views-layout-views">
        @if (Views != null && Model!=null)
        {
            <CascadingValue Value="@this">
                <CascadingValue Value="@Model">
                    @if(Views != null)
                    {
                        @Views
                    }
                </CascadingValue>
            </CascadingValue>
        }
    </div>
    <div class="@(IsBusy ? "views-loader-show" : "views-loader-hide" )">
        <PROLoader BusyMessage="@BusyMessage" />
    </div>
</div>
