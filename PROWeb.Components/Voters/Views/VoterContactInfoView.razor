@using PROWeb.Components.ViewModels.Voter;
@using PROWeb.Components.Voters.Views;
@inherits VoterView<IVoterContactInfoViewModel>

<div class="voter-contact-info-view">
    <div class="voter-contact-info-title mb-2">Contact Details</div>
    <div class="col-4 gy-1">
        <label>Home Phone:</label>
        @if(!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@nameof(IVoterContactInfoViewModel.PhoneHome)" />
        }
        else
        {
            <TelerikTextBox @bind-Value="@DetailsContext.PhoneHome"/>
        }
    </div>
    <div class="col-4 gy-1">
        <label>Work Phone:</label>
        @if (!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@nameof(IVoterContactInfoViewModel.PhoneWork)" />
        }
        else
        {
            <TelerikTextBox @bind-Value="@DetailsContext.PhoneWork" />
        }
    </div>
    <div class="col-4">
        <label>Contact Phone:</label>
        <label>Work Phone:</label>
        @if (!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@nameof(IVoterContactInfoViewModel.ContactPhone)" />
        }
        else
        {
            <TelerikTextBox @bind-Value="@DetailsContext.ContactPhone" />
        }
    </div>
    <div class="col-4">
        <label>Driver License:</label>
        @if (!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@nameof(IVoterContactInfoViewModel.DriverLicense)" />
        }
        else
        {
            <TelerikTextBox @bind-Value="@DetailsContext.DriverLicense" />
        }
    </div>
    <div class="col-8">
        <label>Email:</label>
        @if (!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@nameof(IVoterContactInfoViewModel.Email)" />
        }
        else
        {
            <TelerikTextBox @bind-Value="@DetailsContext.Email" />
        }
    </div>
    <div class="col-8">
        <label>Comment:</label>
        @if (!Editable)
        {
            <textarea readonly style="height:100px" class="k-input k-input-solid k-input-md k-rounded-md">@nameof(IVoterContactInfoViewModel.Comment)</textarea>
        }
        else
        {
            <TelerikTextArea @bind-Value="@DetailsContext.Comment" />
        }
    </div>
</div>