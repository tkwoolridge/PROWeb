@using PROWeb.Components.ViewModels.Voter;
@using PROWeb.Components.Voters.Views;
@inherits PROView<IVoterContactInfoViewModel>

<div class="voter-contact-info-view">
    <div class="voter-contact-info-title mb-2">Contact Details</div>
    <label>Home Phone:</label>
    @if(!Editable)
    {
        <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@Context.PhoneHome" />
    }
    else
    {
        <TelerikTextBox @bind-Value="@Context.PhoneHome"/>
    }
    <label>Work Phone:</label>
    @if (!Editable)
    {
        <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@Context.PhoneWork" />
    }
    else
    {
        <TelerikTextBox @bind-Value="@Context.PhoneWork" />
    }
    <label>Contact Phone:</label>
    @if (!Editable)
    {
        <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@Context.ContactPhone" />
    }
    else
    {
        <TelerikTextBox @bind-Value="@Context.ContactPhone" />
    }
    <label>Driver License:</label>
    @if (!Editable)
    {
        <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@Context.ContactPhone" />
    }
    else
    {
        <TelerikTextBox @bind-Value="@Context.DriverLicense" />
    }
    <div class="voter-contact-email-comment-view">
        <label>Email:</label>
        @if (!Editable)
        {
            <input readonly class="k-input k-input-solid k-input-md k-rounded-md" type="text" value="@Context.Email" />
        }
        else
        {
            <TelerikTextBox @bind-Value="@Context.Email" />
        }
        <label>Comment:</label>
        <span class="k-textarea k-input telerik-blazor k-input-solid k-rounded-md k-input-md">
        @if (!Editable)
        {
            <textarea readonly aria-multiline="true" class="k-input-inner">@Context.Comment</textarea>
        }
        else
        {
            <TelerikTextArea @bind-Value="@Context.Comment" />
        }
        </span>
    </div>
</div>