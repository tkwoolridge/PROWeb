@using PROWeb.Components.ViewModels.Voter;
@using PROWeb.Components.Assessments;
@using PROWeb.Components.Voters.Views;
@inherits VoterView<IVoterAssessmentViewModel>

<div class="voter-address-view">
    <div class="voter-address-title w-100"> Address: </div>
    <input type="textbox" readonly class="voter-address-assessment k-input k-input-solid k-input-md k-rounded-md w-100" value="@DetailsContext.AssessmentNo" />
    <input type="textbox" readonly class="@(Editable? "voter-address-address1-edit" : "voter-address-address1" ) k-input k-input-solid k-input-md k-rounded-md w-100" value="@DetailsContext.Address1" />
    @if (Editable)
    {
        <TelerikButton Class="voter-open-assesment-dialog" OnClick="@OnUpdate" Icon="home" />
    }
    <input type="textbox" readonly class="w-100 k-input k-input-solid k-input-md k-rounded-md w-100" value="@DetailsContext.HouseNo" />
    <input type="textbox" readonly class="voter-address-address2 k-input k-input-solid k-input-md k-rounded-md w-100" value="@DetailsContext.Address2" />
    <input type="textbox" readonly class="voter-address-postal-code k-input k-input-solid k-input-md k-rounded-md w-100" value="@DetailsContext.PostalCode" />
    <input type="textbox" readonly class="voter-address-parish k-input k-input-solid k-input-md k-rounded-md w-100" value="@DetailsContext.ParishName" />
    <input type="textbox" readonly class="voter-address-country k-input k-input-solid k-input-md k-rounded-md w-100" value="@DetailsContext.ConstituencyName" />
    <input type="textbox" readonly class="k-input k-input-solid k-input-md k-rounded-md w-100" value="@DetailsContext.ConstituencyNo" />
    <input type="textbox" readonly class="voter-address-constituency k-input k-input-solid k-input-md k-rounded-md w-100" value="@DetailsContext.ConstituencyName" />
</div>

<AssessmentRegistryDialog @ref="@AssessmentRegistryDialogRef" Confirm="@OnAssessmentSelectionConfirm" />
